{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "headers": [
    { "source": "/build-info.json", "headers": [
      { "key": "Cache-Control", "value": "no-store" }
    ] }
  ],
  "rewrites": [
    { "source": "/((?!build-info\\.json$).*)", "destination": "/index.html" }
  ]
}
